  "rules": {
    "noDividerLines": true,
    "allowedHairlines": [
      "tabellceller",
      "formulärfält",
      "mobilmenyns listor"
    ],
    "accentNeverAsBorder": true,
    "noGradients": true,
    "noShadows": true,
    "noRoundedRectangles": true,
    "noDarkMode": true,
    "photosAlwaysGrayscale": true,
    "photoFilter": "grayscale(1) contrast(1.05)",
    "iconsAlwaysFullColor": true,
    "maxOnePrimaryButtonPerView": true,
    "lastProcessStepAlwaysMagenta": true,
    "language": "sv",
    "noExclamationMarks": true,
    "exceptions": [
      "dropdown-lagret har diffus skugga",
      "verktyg och appar har mörk rosagrå topbar #3D2535",
      "skeleton-shimmer, spinner och radioknappar är runda/gradient av funktionella skäl"
    ]
  },
