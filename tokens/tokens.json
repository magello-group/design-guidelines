{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Magellos designspråk som maskinläsbara tokens. Källa för människor och AI-agenter som skapar webb, dokument, presentationer, bilder och sociala medier. CSS-tokens finns i styleguide/css/magello.css och ska hållas i synk med den här filen.",
  "version": "0.1.0",
  "color": {
    "neutral": {
      "black": {
        "value": "#000000",
        "css": "--mg-black",
        "role": "Brödtext och rubriker i löpande innehåll"
      },
      "white": {
        "value": "#FFFFFF",
        "css": "--mg-white",
        "role": "Bakgrund, ytor ovanpå foto"
      },
      "text-2": {
        "value": "#4C4A4A",
        "css": "--mg-text-2",
        "role": "Underrubriker, ingresser och sekundär text"
      },
      "rose-50": {
        "value": "#F7F3F3",
        "css": "--mg-rose-50",
        "role": "Ljusaste bakgrund, faktarutor, tabellband"
      },
      "rose-100": {
        "value": "#F4EBEB",
        "css": "--mg-rose-100",
        "role": "Signaturytan (header), sektionsbakgrund, textrutor"
      },
      "rose-200": {
        "value": "#E3D6D6",
        "css": "--mg-rose-200",
        "role": "Sekundär knapp, tabellrubrik, ljusa fyllnader"
      },
      "rose-300": {
        "value": "#DED4D4",
        "css": "--mg-rose-300",
        "role": "Hover på sekundär knapp, tabellsummering"
      },
      "grey-300": {
        "value": "#BFBFBF",
        "css": "--mg-grey-300",
        "role": "Diskreta etiketter, årtal, brödsmula. Inte för brödtext"
      }
    },
    "accent": {
      "magenta": {
        "value": "#EC008C",
        "css": "--mg-magenta",
        "role": "Primär accent: logotyp, primär knapp, H2, länkar, utvalda ord"
      },
      "blue": {
        "value": "#31ABE2",
        "css": "--mg-blue",
        "role": "Ikoner, processteg, info"
      },
      "orange": {
        "value": "#F9B804",
        "css": "--mg-orange",
        "role": "Ikoner, processteg"
      },
      "red": {
        "value": "#E3012F",
        "css": "--mg-red",
        "role": "Ikoner, processteg, fel"
      },
      "yellow": {
        "value": "#FFDC00",
        "css": "--mg-yellow",
        "role": "Ikoner, processteg, varning"
      },
      "green": {
        "value": "#1BA660",
        "css": "--mg-green",
        "role": "Ikoner, processteg, klart/lyckat"
      }
    },
    "usage": {
      "accentAsFillOnly": true,
      "magentaForLargeAreasWithText": false,
      "maxAccentPerComponent": 1,
      "stepsMayMixAccents": true
    }
  },
  "font": {
    "head": {
      "family": "Roboto Condensed",
      "fallback": "Arial Narrow, Arial, sans-serif",
      "weights": [
        400,
        500,
        700
      ],
      "css": "--mg-font-head",
      "use": "Rubriker, underrubriker, etiketter, knappar, siffror som blickfång"
    },
    "body": {
      "family": "Roboto",
      "fallback": "system-ui, Arial, sans-serif",
      "weights": [
        400,
        500,
        700
      ],
      "italic": [
        400
      ],
      "css": "--mg-font-body",
      "use": "Brödtext, tabeller, listor, sidfot"
    },
    "code": {
      "family": "Consolas",
      "fallback": "ui-monospace, Menlo, monospace",
      "css": "--mg-font-code",
      "use": "Kod i tekniska dokument"
    },
    "source": "https://fonts.google.com/specimen/Roboto+Condensed",
    "special": {
      "family": "Kattux Abc 20",
      "fallback": "Roboto Condensed, Arial Narrow, sans-serif",
      "weights": [400],
      "caseNote": "Bara versaler, gemener ritas som versaler",
      "files": {
        "otf": "fonts/KattuxAbc-Regular.otf",
        "ttf": "fonts/KattuxAbc-Regular.ttf",
        "woff2": "fonts/KattuxAbc-Regular.woff2",
        "woff": "fonts/KattuxAbc-Regular.woff"
      },
      "use": "Specialtypsnitt för speciella tillfällen, främst PowerPoint: ett kort budskap eller citat. Se styleguide/typsnitt.html",
      "missingGlyphs": "Ü ü ß € — ø æ och de flesta accenter utöver Á É á é Å Ä Ö",
      "inMagelloCss": false
    }
  },
  "type": {
    "$note": "Faktor = storlek relativt brödtext. Web är rem, tryck är pt. Rubrik: tätt radavstånd, brödtext: luftigt.",
    "web": {
      "body": {
        "size": "1.125rem",
        "px": 18,
        "lineHeight": 1.6,
        "font": "body",
        "weight": 400
      },
      "h1": {
        "font": "head",
        "weight": 500,
        "size": "clamp(2.25rem, 1.5rem + 3.2vw, 3.5rem)"
      },
      "display": {
        "font": "head",
        "weight": 700,
        "size": "clamp(3.2rem, 2rem + 5vw, 6.5rem)",
        "note": "Sidtitel (DocTitle/ingång)"
      },
      "subtitle": {
        "font": "head",
        "weight": 400,
        "size": "clamp(1.1rem, 1rem + .5vw, 1.35rem)",
        "color": "text-2"
      },
      "h2": {
        "font": "head",
        "weight": 500,
        "size": "clamp(1.5rem, 1.35rem + .6vw, 1.8rem)",
        "color": "magenta",
        "note": "Sektionsrubrik. Svart (700) inne i löpande artikeltext"
      },
      "h3": {
        "font": "head",
        "weight": 700,
        "size": "clamp(1.15rem, 1.1rem + .25vw, 1.35rem)"
      },
      "kicker": {
        "font": "head",
        "weight": 700,
        "size": ".6875rem",
        "letterSpacing": ".14em",
        "case": "upper",
        "color": "magenta"
      },
      "small": {
        "font": "body",
        "size": ".8125rem"
      }
    },
    "profiles": {
      "standard": "Landningssidor",
      "editorial": "Artiklar, case och textsidor (h1 2–3.2rem, h2 1.4–1.9rem, brödtext radhöjd 1.7)",
      "showcase": "Startsida och komponentsidor (större underrubrik och H3, radhöjd 1.5)"
    },
    "print": {
      "h1": {
        "pt": 36,
        "font": "head",
        "weight": 500,
        "factor": 3.6
      },
      "subtitle": {
        "pt": 22,
        "font": "head",
        "weight": 400,
        "factor": 2.2,
        "letterSpacingPt": 0.75,
        "color": "text-2"
      },
      "h2": {
        "pt": 18,
        "font": "head",
        "weight": 500,
        "factor": 1.8,
        "color": "magenta"
      },
      "h3": {
        "pt": 16,
        "font": "head",
        "weight": 700,
        "factor": 1.6
      },
      "h4": {
        "pt": 14,
        "font": "head",
        "weight": 700,
        "factor": 1.4
      },
      "h5": {
        "pt": 12,
        "font": "head",
        "weight": 700,
        "factor": 1.2
      },
      "h6": {
        "pt": 10,
        "font": "head",
        "weight": 700,
        "factor": 1.0
      },
      "body": {
        "pt": 10,
        "font": "body",
        "weight": 400,
        "lineHeight": 1.15
      },
      "header": {
        "pt": 7
      },
      "footer": {
        "pt": 6.5,
        "color": "grey-300"
      }
    },
    "presentation": {
      "title": {
        "ptMin": 40,
        "ptMax": 54
      },
      "h2": {
        "ptMin": 28,
        "ptMax": 32
      },
      "body": {
        "ptMin": 18
      },
      "absoluteMin": 14
    },
    "special": {
      "font": "special",
      "ptMin": 28,
      "ptRecommended": [44, 66],
      "maxPerSlide": 1,
      "where": ["PowerPoint: Fokus - Rubrik på platta", "PowerPoint: Innehåll - Platta", "Affisch, inbjudan eller sociala medier vid speciella tillfällen"],
      "never": ["brödtext", "listor", "tabeller", "knappar", "navigation", "formulär"]
    }
  },
  "space": {
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 36,
    "7": 48,
    "8": 64,
    "9": 96,
    "unit": "px"
  },
  "layout": {
    "contentWidth": 1024,
    "gutter": {
      "mobile": 20,
      "tablet": 40,
      "desktop": 64
    },
    "navHeight": 72,
    "headerExtension": 48,
    "headerHeight": 120,
    "unit": "px",
    "breakpoints": {
      "tablet": 600,
      "desktop": 1024,
      "mobileMenu": 768,
      "cardGridTwoCol": 900
    },
    "alignment": "Allt innehåll delar vänsterkant med logotypen"
  },
  "motion": {
    "button-hover": {
      "property": "clip-path",
      "duration": "350ms",
      "easing": "ease"
    },
    "card-hover": {
      "property": "clip-path, background",
      "duration": "350ms",
      "easing": "ease"
    },
    "image-hover": {
      "property": "clip-path",
      "duration": "400ms",
      "easing": "ease"
    },
    "header-collapse": {
      "property": "clip-path, padding-bottom",
      "duration": "400ms",
      "easing": "ease"
    },
    "header-rotate": {
      "property": "transform",
      "duration": "600ms",
      "easing": "cubic-bezier(0.4, 0, 0.6, 1)"
    },
    "side-nav-in": {
      "property": "transform, opacity",
      "duration": "420ms / 280ms",
      "delay": "180ms",
      "easing": "cubic-bezier(0, 0, 0.2, 1)"
    },
    "mobile-menu": {
      "property": "transform",
      "duration": "380ms",
      "easing": "cubic-bezier(0, 0, 0.2, 1)"
    },
    "dropdown": {
      "property": "opacity, transform",
      "duration": "180ms",
      "easing": "ease",
      "closeDelay": "220ms"
    },
    "reducedMotion": "Respektera prefers-reduced-motion: inga transitions, hover öppnar inte formen"
  },
